<style>
:root {
  --page: #f7f7f5; --panel: #ffffff; --ink: #1c1c1a; --muted: #5d5d58; --line: #dcdcd6;
  --critical: #a4161a; --high: #b45309; --medium: #4b5563; --good: #166534; --warn-bg: #fff4e0;
  --warn-ink: #7a4a00; --quote-bg: #fde8e8; --quote-ink: #8a1115;
}
@media (prefers-color-scheme: dark) {
  :root {
    --page: #161614; --panel: #20201d; --ink: #ecece6; --muted: #a8a8a0; --line: #3a3a35;
    --critical: #f87171; --high: #fbbf24; --medium: #9ca3af; --good: #4ade80; --warn-bg: #33270f;
    --warn-ink: #fcd38a; --quote-bg: #3d1a1a; --quote-ink: #fca5a5;
  }
}
* { box-sizing: border-box; }
body {
  margin: 0; padding: 32px 16px 64px; background: var(--page); color: var(--ink);
  font: 16px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}
main { max-width: 860px; margin: 0 auto; }
h1 { margin: 0 0 4px; font-size: 28px; }
h2 { margin: 40px 0 12px; font-size: 20px; }
.meta { margin: 0; color: var(--muted); font-size: 14px; }
.notice {
  margin: 20px 0; padding: 12px 16px; border-radius: 8px; background: var(--warn-bg);
  color: var(--warn-ink); font-size: 15px;
}
.totals { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 12px; }
.total { padding: 14px; border: 1px solid var(--line); border-radius: 8px; background: var(--panel); }
.total b { display: block; font-size: 26px; line-height: 1.2; }
.total span { color: var(--muted); font-size: 14px; }
.test {
  margin: 0 0 16px; padding: 18px; border: 1px solid var(--line); border-radius: 8px;
  background: var(--panel);
}
.test h3 { margin: 0 0 10px; font-size: 16px; overflow-wrap: anywhere; }
.badge {
  display: inline-block; margin-right: 8px; padding: 1px 8px; border-radius: 99px;
  color: #fff; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: .03em;
}
@media (prefers-color-scheme: dark) { .badge { color: #161614; } }
.badge.critical { background: var(--critical); }
.badge.high { background: var(--high); }
.badge.medium { background: var(--medium); }
dl { margin: 0; }
dt { margin-top: 10px; color: var(--muted); font-size: 13px; font-weight: 600; }
dd { margin: 2px 0 0; white-space: pre-wrap; overflow-wrap: anywhere; }
dd.quote { padding: 2px 8px; border-radius: 4px; background: var(--quote-bg); color: var(--quote-ink); }
code { font: 13px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; }
ul.plain { margin: 0; padding-left: 20px; color: var(--muted); font-size: 14px; overflow-wrap: anywhere; }
.empty { color: var(--good); }
table.numbers { border-collapse: collapse; width: 100%; font-size: 14px; }
table.numbers th, table.numbers td { border-bottom: 1px solid var(--line); padding: 6px 8px; text-align: left; overflow-wrap: anywhere; }
table.numbers th { font-weight: 500; }
</style>
