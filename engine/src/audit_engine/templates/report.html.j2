<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'">
<title>Audit report</title>
{% include "_style.html.j2" %}
</head>
<body>
<main>
<h1>Audit report</h1>
<p class="meta">
  {% if report.source %}Policy: {{ report.source.document }}. {% endif %}
  Generated {{ report.generated_at.strftime("%-d %B %Y, %H:%M %Z") }}.
</p>

<p class="notice"><strong>Treat these verdicts with care.</strong> The AI judge's accuracy hasn't been measured against hand-marked results yet. A pass here isn't proof that a bot is safe.</p>
{% if report.cut_short %}
<p class="notice"><strong>This report is incomplete.</strong> The results file was cut short, so its last verdict is missing.</p>
{% endif %}
{% if report.actions_not_checked %}
<p class="notice"><strong>What the bot did wasn't checked on {{ report.actions_not_checked }} answers.</strong> Those verdicts rely on what the bot said, which can differ from what it did.</p>
{% endif %}

<section class="totals" aria-label="Totals">
  <div class="total"><b>{{ report.totals.tests }}</b><span>Tests</span></div>
  <div class="total"><b>{{ report.totals.counts.get("fail", 0) }}</b><span>Failed answers</span></div>
  <div class="total"><b>{{ report.totals.counts.get("pass", 0) }}</b><span>Passed answers</span></div>
  <div class="total"><b>{{ report.totals.counts.get("unclear", 0) }}</b><span>For a person to check</span></div>
  <div class="total"><b>{{ report.totals.counts.get("error", 0) + report.totals.counts.get("not_run", 0) }}</b><span>Not judged</span></div>
</section>

<h2>The numbers</h2>
<table class="numbers">
  <tr><th>Tests fully passed</th><td>{{ report.metrics.test_pass_percent }}% ({{ report.passed | length }} of {{ report.totals.tests }})</td></tr>
  <tr><th>Answers passed</th><td>{{ report.metrics.answer_pass_percent }}% of {{ report.totals.answers }}</td></tr>
  <tr><th>Answers for a person to check</th><td>{{ report.metrics.needs_person_percent }}%</td></tr>
  <tr><th>Answers not judged</th><td>{{ report.metrics.not_judged_percent }}%</td></tr>
  <tr><th>Answers decided by code, with no AI</th><td>{{ report.metrics.decided_by_code_percent }}%</td></tr>
  {% if report.metrics.repeated_tests %}
  <tr><th>Asked more than once, with both passes and fails</th><td>{{ report.metrics.inconsistent_percent }}% ({{ report.metrics.inconsistent_tests }} of {{ report.metrics.repeated_tests }} tests)</td></tr>
  {% endif %}
  <tr><th>Failed tests by severity</th><td>Critical {{ report.metrics.severities.get("critical", 0) }}, high {{ report.metrics.severities.get("high", 0) }}, medium {{ report.metrics.severities.get("medium", 0) }}</td></tr>
  {% if report.metrics.coverage %}
  <tr><th>Approved policy items tested</th><td>{{ report.metrics.coverage.percent }}% ({{ report.metrics.coverage.tested_items }} of {{ report.metrics.coverage.approved_items }}){% if report.metrics.coverage.unapproved_items %}. {{ report.metrics.coverage.unapproved_items }} more weren't approved, so weren't tested{% endif %}</td></tr>
  {% if report.metrics.coverage.untested %}
  <tr><th>Approved items not tested</th><td>{{ report.metrics.coverage.untested | join(", ") }}</td></tr>
  {% endif %}
  {% else %}
  <tr><th>Approved policy items tested</th><td>Not shown. Give the contract with --contract to work this out.</td></tr>
  {% endif %}
</table>
<p class="meta">These numbers describe the questions in this run. They don't say how the bot will answer questions nobody asked, so no percentage here means the bot is that safe.</p>

<h2>By risk area</h2>
<table class="numbers">
  <tr><th>Area</th><td><b>Passed</b></td><td><b>Failed</b></td><td><b>For a person</b></td><td><b>Not judged</b></td><td><b>Pass rate</b></td></tr>
  {% for area in report.metrics.areas %}
  <tr><th>{{ area.area }}</th><td>{{ area.passed }}</td><td>{{ area.failed }}</td><td>{{ area.unclear }}</td><td>{{ area.not_judged }}</td><td>{{ area.pass_percent }}%</td></tr>
  {% endfor %}
</table>

{% macro show(summary, verdict) %}
<article class="test">
  <h3>
    {% if summary.severity %}<span class="badge {{ summary.severity }}">{{ summary.severity }}</span>{% endif %}
    {{ summary.case.id }}
  </h3>
  <dl>
    <dt>Customer asked</dt>
    <dd>{{ summary.case.question }}</dd>
    {% if summary.example %}
    {% if summary.example.earlier %}
    <dt>Earlier in the chat</dt>
    {% for turn in summary.example.earlier %}<dd>Customer: {{ turn.customer }}<br>Bot: {{ turn.bot }}</dd>
    {% endfor %}
    {% endif %}
    {% if summary.example.reply is not none %}
    <dt>Bot replied</dt>
    <dd>{{ summary.example.reply }}</dd>
    {% endif %}
    {% if summary.example.offending_quote %}
    <dt>The problem</dt>
    <dd class="quote">{{ summary.example.offending_quote }}</dd>
    {% endif %}
    {% if summary.example.actions %}
    <dt>What the bot did</dt>
    <dd><code>{{ summary.example.actions | tojson(indent=2) }}</code></dd>
    {% endif %}
    <dt>Why</dt>
    <dd>{{ summary.example.reason }}</dd>
    {% endif %}
    {% if summary.case.statement %}
    <dt>What the policy says</dt>
    <dd>{{ summary.case.statement }}{% if summary.case.expected_value %} (Expected: {{ summary.case.expected_value }}){% endif %}</dd>
    <dt>Source{% if report.source %}: {{ report.source.document }}{% endif %}{% if summary.case.section %}, {{ summary.case.section }}{% endif %}</dt>
    <dd>{{ summary.case.quote }}</dd>
    {% endif %}
    {% if summary.case.expect %}
    <dt>What a good bot does</dt>
    <dd>{{ summary.case.expect }}</dd>
    {% endif %}
    {% if verdict %}
    <dt>How often</dt>
    <dd>{{ summary.counts.get(verdict, 0) }} of {{ summary.answers }} answers</dd>
    {% endif %}
  </dl>
</article>
{% endmacro %}

<h2>Failed tests ({{ report.failed | length }})</h2>
{% for summary in report.failed %}{{ show(summary, "fail") }}{% else %}
<p class="empty">No test failed.</p>
{% endfor %}

{% if report.unclear %}
<h2>For a person to check ({{ report.unclear | length }})</h2>
{% for summary in report.unclear %}{{ show(summary, "unclear") }}{% endfor %}
{% endif %}

{% if report.gaps %}
<h2>Not judged ({{ report.gaps | length }})</h2>
{% for summary in report.gaps %}{{ show(summary, none) }}{% endfor %}
{% endif %}

<h2>Passed tests ({{ report.passed | length }})</h2>
{% if report.passed %}
<ul class="plain">
{% for summary in report.passed %}<li>{{ summary.case.id }} ({{ summary.answers }} of {{ summary.answers }} answers)</li>
{% endfor %}</ul>
{% else %}
<p class="meta">None.</p>
{% endif %}
</main>
</body>
</html>
