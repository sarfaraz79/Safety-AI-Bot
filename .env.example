# Copy this file to .env and fill it in. Never commit .env.
# Only needed to run the bot; the tests never call a real model.

# Any provider with an OpenAI-compatible Chat Completions API works.
# OpenAI (the default endpoint):
DEMO_BOT_LLM_MODEL=gpt-5.4-mini
DEMO_BOT_LLM_API_KEY=

# Claude: use a Claude API key and also set
# DEMO_BOT_LLM_BASE_URL=https://api.anthropic.com/v1/
# DEMO_BOT_LLM_MODEL=claude-haiku-5-5

# Ollama, free on your own computer (any non-empty key works):
# DEMO_BOT_LLM_BASE_URL=http://localhost:11434/v1
# DEMO_BOT_LLM_MODEL=llama3.1
# DEMO_BOT_LLM_API_KEY=ollama

# The audit engine has its own settings, so it can use a different model from the bot under test.
# Claude:
# AUDIT_ENGINE_LLM_BASE_URL=https://api.anthropic.com/v1/
# AUDIT_ENGINE_LLM_MODEL=claude-haiku-5-5
# AUDIT_ENGINE_LLM_API_KEY=

# Which system prompt to use: v1 (current) or v2 (the risky rewrite).
DEMO_BOT_PROMPT_VERSION=v1

# Only needed to expose the bot beyond this computer. At least 16 characters; make one with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# DEMO_BOT_AUTH_TOKEN=
# DEMO_BOT_HOST=127.0.0.1
# DEMO_BOT_PORT=8000
